<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Radix Colors, dark appearance. Values taken from @radix-ui/colors. -->
    <Color x:Key="RadixGray1">#111111</Color>
    <Color x:Key="RadixGray2">#191919</Color>
    <Color x:Key="RadixGray3">#222222</Color>
    <Color x:Key="RadixGray4">#2A2A2A</Color>
    <Color x:Key="RadixGray5">#313131</Color>
    <Color x:Key="RadixGray6">#3A3A3A</Color>
    <Color x:Key="RadixGray7">#484848</Color>
    <Color x:Key="RadixGray8">#606060</Color>
    <Color x:Key="RadixGray11">#B4B4B4</Color>
    <Color x:Key="RadixGray12">#EEEEEE</Color>

    <Color x:Key="RadixOrange3">#331E0B</Color>
    <Color x:Key="RadixOrange7">#7E451D</Color>
    <Color x:Key="RadixOrange8">#A35829</Color>
    <Color x:Key="RadixOrange9">#F76B15</Color>
    <Color x:Key="RadixOrange10">#FF801F</Color>
    <Color x:Key="RadixOrange11">#FFA057</Color>
    <Color x:Key="RadixOrange12">#FFE0C2</Color>

    <SolidColorBrush x:Key="RadixGray1Brush" Color="{StaticResource RadixGray1}"/>
    <SolidColorBrush x:Key="RadixGray2Brush" Color="{StaticResource RadixGray2}"/>
    <SolidColorBrush x:Key="RadixGray3Brush" Color="{StaticResource RadixGray3}"/>
    <SolidColorBrush x:Key="RadixGray4Brush" Color="{StaticResource RadixGray4}"/>
    <SolidColorBrush x:Key="RadixGray6Brush" Color="{StaticResource RadixGray6}"/>
    <SolidColorBrush x:Key="RadixGray8Brush" Color="{StaticResource RadixGray8}"/>
    <SolidColorBrush x:Key="RadixGray11Brush" Color="{StaticResource RadixGray11}"/>
    <SolidColorBrush x:Key="RadixGray12Brush" Color="{StaticResource RadixGray12}"/>

    <SolidColorBrush x:Key="RadixOrange3Brush" Color="{StaticResource RadixOrange3}"/>
    <SolidColorBrush x:Key="RadixOrange8Brush" Color="{StaticResource RadixOrange8}"/>
    <SolidColorBrush x:Key="RadixOrange9Brush" Color="{StaticResource RadixOrange9}"/>
    <SolidColorBrush x:Key="RadixOrange10Brush" Color="{StaticResource RadixOrange10}"/>
    <SolidColorBrush x:Key="RadixOrange11Brush" Color="{StaticResource RadixOrange11}"/>

    <!-- Radix radius scale: medium 6, large 12. -->
    <CornerRadius x:Key="RadixRadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="RadixRadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="RadixRadiusFull">999</CornerRadius>

</ResourceDictionary>
