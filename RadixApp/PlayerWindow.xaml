<ui:FluentWindow x:Class="WpfApp1.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Now playing" Height="216" Width="400"
        MinHeight="190" MinWidth="340"
        WindowStartupLocation="Manual"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid Margin="12,8,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="PlayerBar" Grid.Row="0" Title="Now playing" Height="28"/>
        <Grid Grid.Row="1" Margin="0,4,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="92" Height="92" CornerRadius="14" ClipToBounds="True"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                <Image x:Name="ArtImg" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,2,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TrackTitle" FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxHeight="44" TextWrapping="Wrap"/>
                <TextBlock x:Name="TrackArtist" FontSize="12" Opacity="0.7"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                <TextBlock x:Name="TrackTime" FontSize="12" Opacity="0.6" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="BtnPrev" Margin="0,0,4,0" Click="BtnPrev_Click">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Previous24"/></ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="BtnPlay" Appearance="Primary" Margin="0,0,4,0" Click="BtnPlay_Click">
                    <ui:Button.Icon><ui:SymbolIcon x:Name="PlayIcon" Symbol="Play24"/></ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="BtnNext" Margin="0,0,8,0" Click="BtnNext_Click">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Next24"/></ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="BtnTray" Click="BtnTray_Click">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowDown24"/></ui:Button.Icon>
                </ui:Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="BtnPip" Margin="0,0,4,0" Click="BtnPip_Click">
                    <Path Data="{StaticResource LucidePip}" Style="{StaticResource LucideIcon}" Width="15" Height="15"/>
                </ui:Button>
                <ui:Button x:Name="BtnClose" Click="BtnClose_Click">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss24"/></ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
