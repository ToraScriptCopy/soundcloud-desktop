<ui:FluentWindow x:Class="WpfApp1.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Settings" Height="700" Width="440"
        MinHeight="520" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="SetBar" Grid.Row="0" Title="Settings" Height="30"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,2,16,16">
                <TextBlock x:Name="LangLabel2" Margin="2,0,0,4" FontSize="12"/>
                <ComboBox x:Name="LangBox2" SelectionChanged="LangBox2_SelectionChanged"/>

                <TextBlock x:Name="ThemeLabel2" Margin="2,10,0,4" FontSize="12"/>
                <ComboBox x:Name="ThemeBox" SelectionChanged="ThemeBox_SelectionChanged"/>

                <ui:ToggleSwitch x:Name="HideHeaderSwitch2" Margin="0,12,0,0"
                                 Checked="HideHeaderSwitch2_Changed" Unchecked="HideHeaderSwitch2_Changed"/>
                <ui:ToggleSwitch x:Name="TopmostSwitch" Margin="0,6,0,0"
                                 Checked="TopmostSwitch_Changed" Unchecked="TopmostSwitch_Changed"/>
                <ui:ToggleSwitch x:Name="TrayHideSwitch" Margin="0,6,0,0"
                                 Checked="TrayHideSwitch_Changed" Unchecked="TrayHideSwitch_Changed"/>
                <ui:ToggleSwitch x:Name="AutostartSwitch" Margin="0,6,0,0"
                                 Checked="AutostartSwitch_Changed" Unchecked="AutostartSwitch_Changed"/>
                <ui:ToggleSwitch x:Name="AdBlockSwitch" Margin="0,6,0,0"
                                 Checked="AdBlockSwitch_Changed" Unchecked="AdBlockSwitch_Changed"/>
                <ui:ToggleSwitch x:Name="SiteAnimsSwitch" Margin="0,6,0,0"
                                 Checked="SiteAnimsSwitch_Changed" Unchecked="SiteAnimsSwitch_Changed"/>
                <ui:ToggleSwitch x:Name="ReDesignSwitch" Margin="0,6,0,0"
                                 Checked="ReDesignSwitch_Changed" Unchecked="ReDesignSwitch_Changed"/>
                <ui:Button x:Name="RdOpenBtn" HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="RdOpenBtn_Click"/>
                <ui:ToggleSwitch x:Name="PlayerPopupSwitch" Margin="0,6,0,14"
                                 Checked="PlayerPopupSwitch_Changed" Unchecked="PlayerPopupSwitch_Changed"/>

                <TextBlock x:Name="ExtHeader" Margin="2,0,0,6" FontSize="11" Opacity="0.6" FontWeight="SemiBold"/>
                <ListBox x:Name="ExtList" Height="70" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:Button x:Name="ExtAddBtn" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,0,4,0" Click="ExtAddBtn_Click"/>
                    <ui:Button x:Name="ExtDelBtn" Grid.Column="1" Click="ExtDelBtn_Click"/>
                </Grid>

                <TextBlock x:Name="BindsHeader" Margin="2,0,0,6" FontSize="11" Opacity="0.6" FontWeight="SemiBold"/>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="HotPrevLbl" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="2,4"/>
                    <ComboBox x:Name="HotPrevBox" Grid.Row="0" Grid.Column="1" Margin="0,4" SelectionChanged="HotBox_SelectionChanged"/>
                    <TextBlock x:Name="HotPlayLbl" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="2,4"/>
                    <ComboBox x:Name="HotPlayBox" Grid.Row="1" Grid.Column="1" Margin="0,4" SelectionChanged="HotBox_SelectionChanged"/>
                    <TextBlock x:Name="HotNextLbl" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="2,4"/>
                    <ComboBox x:Name="HotNextBox" Grid.Row="2" Grid.Column="1" Margin="0,4" SelectionChanged="HotBox_SelectionChanged"/>
                    <TextBlock x:Name="HotVolDnLbl" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="2,4"/>
                    <ComboBox x:Name="HotVolDnBox" Grid.Row="3" Grid.Column="1" Margin="0,4" SelectionChanged="HotBox_SelectionChanged"/>
                    <TextBlock x:Name="HotVolUpLbl" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="2,4"/>
                    <ComboBox x:Name="HotVolUpBox" Grid.Row="4" Grid.Column="1" Margin="0,4" SelectionChanged="HotBox_SelectionChanged"/>
                </Grid>
                <TextBlock x:Name="HotHint" Margin="2,4,0,0" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                <ui:Button x:Name="DefaultsBtn" HorizontalAlignment="Stretch" Margin="0,6,0,14" Click="DefaultsBtn_Click"/>

                <ui:Button x:Name="CacheBtn" HorizontalAlignment="Stretch" Click="CacheBtn_Click"/>
                <TextBlock x:Name="CacheStatus" Margin="2,4,0,0" FontSize="11" Opacity="0.7"/>
                <ui:Button x:Name="VaultResetBtn" HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="VaultResetBtn_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
