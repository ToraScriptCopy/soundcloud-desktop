<ui:FluentWindow x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="SoundCloud Desktop Beta" Height="760" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        StateChanged="MainWindow_StateChanged"
        Closing="MainWindow_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SoundCloud Desktop Beta" />

        <!-- Тулбар -->
        <Grid Grid.Row="1" Margin="12,4,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button x:Name="BtnMenu" Margin="0,0,4,0" Click="BtnMenu_Click">
                    <Path Data="{StaticResource LucideMenu}" Style="{StaticResource LucideIcon}" Width="16" Height="16"/>
                </ui:Button>
                <ui:Button x:Name="BtnBack" Margin="0,0,4,0" Click="BtnBack_Click">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowLeft24"/></ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="BtnFwd" Margin="0,0,4,0" Click="BtnFwd_Click">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowRight24"/></ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="BtnReload" Margin="0,0,4,0" Click="BtnReload_Click">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24"/></ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="BtnHome" Click="BtnHome_Click">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Home24"/></ui:Button.Icon>
                </ui:Button>
            </StackPanel>
            <ui:TextBox x:Name="AddrBox" Grid.Column="1" Margin="8,0"
                        KeyDown="AddrBox_KeyDown"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button x:Name="BtnGo" Appearance="Primary" Margin="0,0,4,0" Click="BtnGo_Click"/>
                <ui:Button x:Name="BtnPipHere" Margin="0,0,4,0" Click="BtnPipHere_Click">
                    <Path Data="{StaticResource LucidePip}" Style="{StaticResource LucideIcon}" Width="16" Height="16"/>
                </ui:Button>
                <ui:Button x:Name="BtnSettings" Click="BtnSettings_Click">
                    <Path Data="{StaticResource LucideSettings}" Style="{StaticResource LucideIcon}" Width="16" Height="16"/>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Центр: складной сайдбар + сайт -->
        <Grid Grid.Row="2" Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="SidebarView" Grid.Column="0" Width="240" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <ui:Button x:Name="BtnNavHome" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,4" Click="BtnHome_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource LucideHouse}" Style="{StaticResource LucideIcon}" Width="16" Height="16"/>
                            <TextBlock x:Name="NavHomeTxt" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="BtnNavCharts" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,4" Click="BtnCharts_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource LucideChart}" Style="{StaticResource LucideIcon}" Width="16" Height="16"/>
                            <TextBlock x:Name="NavChartsTxt" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="BtnNavLikes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,14" Click="BtnLikes_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource LucideHeart}" Style="{StaticResource LucideIcon}" Width="16" Height="16"/>
                            <TextBlock x:Name="NavLikesTxt" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <TextBlock x:Name="PipHeader" Margin="2,0,0,6" FontSize="11" Opacity="0.6" FontWeight="SemiBold"/>
                    <ui:TextBox x:Name="PlaylistBox" KeyDown="PlaylistBox_KeyDown"/>
                    <ui:Button x:Name="BtnPipPlay" Appearance="Primary" HorizontalAlignment="Stretch"
                               Margin="0,6,0,0" Click="BtnPipPlay_Click"/>
                    <ui:Button x:Name="BtnPipOpen" HorizontalAlignment="Stretch"
                               Margin="0,4,0,0" Click="BtnPipOpen_Click"/>
                    <TextBlock x:Name="PipHint" Margin="2,6,0,14" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:Button x:Name="BtnCopy" Click="BtnCopy_Click">
                            <Path Data="{StaticResource LucideCopy}" Style="{StaticResource LucideIcon}" Width="15" Height="15"/>
                        </ui:Button>
                        <ui:Button x:Name="BtnExt" Margin="4,0,0,0" Click="BtnExt_Click">
                            <Path Data="{StaticResource LucideExternal}" Style="{StaticResource LucideIcon}" Width="15" Height="15"/>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <wv2:WebView2 x:Name="Browser" Grid.Column="1"/>
        </Grid>

        <!-- Низ: только трек + звук -->
        <Border Grid.Row="3" Margin="12,8,12,12" Padding="10,8" CornerRadius="10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Path x:Name="VolIcon" Data="{StaticResource LucideVol}" Width="16" Height="16"
                          Stretch="Uniform" Fill="Transparent" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="VolSlider" Width="140" Minimum="0" Maximum="100" Value="80"
                            VerticalAlignment="Center" ValueChanged="VolSlider_ValueChanged"/>
                    <TextBlock x:Name="VolLabel" Text="80%" Width="42" VerticalAlignment="Center" Margin="6,0"/>
                    <ui:ToggleSwitch x:Name="MuteSwitch"
                                     Checked="MuteSwitch_Changed" Unchecked="MuteSwitch_Changed"/>
                </StackPanel>
                <TextBlock x:Name="NowPlaying" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
            </DockPanel>
        </Border>

        <ui:SnackbarPresenter x:Name="SnackbarPresenter"
                              Grid.Row="0" Grid.RowSpan="4"
                              VerticalAlignment="Bottom" HorizontalAlignment="Center"
                              Margin="0,0,0,70"/>
        <ui:ContentDialogHost x:Name="DialogHost"
                              Grid.Row="0" Grid.RowSpan="4"/>
    </Grid>
</ui:FluentWindow>
